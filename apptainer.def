Bootstrap: docker
From: python:3.13-slim-bookworm

%arguments
    TORCH_VERSION=2.14.1
    TORCH_INDEX=https://download.pytorch.org/whl/cu126
    WITH_GAMMALOOP=0
    BUILD_CORES=4

# Run apptainer build from the checkout root. No Nix inputs enter this image.
%files
    pyproject.toml /build-src/pyproject.toml
    README.md /build-src/README.md
    MANIFEST.in /build-src/MANIFEST.in
    src /build-src/src
    native/gammaloop/Cargo.toml /build-src/native/gammaloop/Cargo.toml
    native/gammaloop/Cargo.lock /build-src/native/gammaloop/Cargo.lock
    native/gammaloop/pyproject.toml /build-src/native/gammaloop/pyproject.toml
    native/gammaloop/src /build-src/native/gammaloop/src
    native/gammaloop/python /build-src/native/gammaloop/python
    ops/check_runtime.py /usr/local/bin/glnis-check

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    export PIP_DISABLE_PIP_VERSION_CHECK=1
    apt-get update
    # g++ remains available for torch.compile at runtime. Git is needed for
    # the GammaBoard process API dependency, not for checking out this project.
    apt-get install -y --no-install-recommends ca-certificates git g++
    python -m pip install --only-binary=:all: --index-url '{{ TORCH_INDEX }}' 'torch=={{ TORCH_VERSION }}'
    case '{{ WITH_GAMMALOOP }}' in
        0) python -m pip install /build-src ;;
        1)
            apt-get install -y --no-install-recommends curl make pkg-config m4 libgmp-dev libmpfr-dev libmpc-dev
            export CARGO_HOME=/build-cargo RUSTUP_HOME=/build-rustup
            export CARGO_BUILD_JOBS='{{ BUILD_CORES }}'
            curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup.sh
            sh /tmp/rustup.sh -y --profile minimal --no-modify-path
            export PATH="/build-cargo/bin:$PATH"
            python -m pip install '/build-src[gammaloop]' /build-src/native/gammaloop
            rm -rf /build-cargo /build-rustup /tmp/rustup.sh
            ;;
        *) echo 'WITH_GAMMALOOP must be 0 or 1' >&2; exit 2 ;;
    esac
    python -m pip check
    mkdir -p /usr/local/share/glnis
    python -m pip freeze > /usr/local/share/glnis/packages.txt
    chmod +x /usr/local/bin/glnis-check
    rm -rf /build-src /root/.cache/pip /var/lib/apt/lists/*

%environment
    export PYTHONUNBUFFERED=1

%runscript
    exec glnis-gammaboard-sampler "$@"

# Building needs no GPU or license. GPU/Inductor checks are separate, on an
# allocated GPU node, using: apptainer exec --nv IMAGE glnis-check --device cuda:0 --compile
%test
    glnis-check
    python -c 'import importlib.util; from glnis._optional import gammaloop_native; spec=importlib.util.find_spec("glnis_gammaloop_native"); assert spec is None or gammaloop_native().health_check() == "glnis-gammaboard-api rust extension ok"'
