Bootstrap: docker
From: nixos/nix:2.24.11
Stage: build

%arguments
    BUILD_CORES=4

# Build from the local checkout, not from Git. Run `apptainer build` from this
# directory so these relative paths resolve to the project files.
%files
    flake.nix /build-src/glnis_gammaboard_api/flake.nix
    flake.lock /build-src/glnis_gammaboard_api/flake.lock
    pyproject.toml /build-src/glnis_gammaboard_api/pyproject.toml
    Cargo.toml /build-src/glnis_gammaboard_api/Cargo.toml
    Cargo.lock /build-src/glnis_gammaboard_api/Cargo.lock
    src /build-src/glnis_gammaboard_api/src

%post
    set -eux

    mkdir -p /etc/nix
    cat > /etc/nix/nix.conf <<'EOF'
experimental-features = nix-command flakes
sandbox = false
filter-syscalls = false
accept-flake-config = true
max-jobs = 1
cores = {{ BUILD_CORES }}
EOF

    export NIX_CONFIG='experimental-features = nix-command flakes
sandbox = false
filter-syscalls = false
accept-flake-config = true
max-jobs = 1
cores = {{ BUILD_CORES }}'

    cd /build-src/glnis_gammaboard_api
    runtime_path="$(nix build .#runtime --no-link --print-out-paths)"

    mkdir -p /closure/nix/store /closure/opt
    nix-store --query --requisites "${runtime_path}" > /tmp/glnis-runtime-closure
    while IFS= read -r store_path; do
        cp -a "${store_path}" /closure/nix/store/
    done < /tmp/glnis-runtime-closure

    ln -s "${runtime_path}" /closure/opt/glnis-runtime


Bootstrap: docker
From: debian:bookworm-slim
Stage: final

%files from build
    /closure/nix /nix
    /closure/opt /opt

%post
    set -eux

    mkdir -p /usr/local/bin

    cat > /usr/local/bin/glnis-gammaboard-sampler <<'EOF'
#!/bin/sh
exec /opt/glnis-runtime/bin/glnis-gammaboard-sampler "$@"
EOF

    cat > /usr/local/bin/glnis_gammaboard_sampler <<'EOF'
#!/bin/sh
exec /opt/glnis-runtime/bin/glnis-gammaboard-sampler "$@"
EOF

    cat > /usr/local/bin/python <<'EOF'
#!/bin/sh
exec /opt/glnis-runtime/bin/python "$@"
EOF

    chmod +x \
        /usr/local/bin/glnis-gammaboard-sampler \
        /usr/local/bin/glnis_gammaboard_sampler \
        /usr/local/bin/python

%environment
    export OMP_NUM_THREADS="${OMP_NUM_THREADS:-64}"
    export PYTHONUNBUFFERED=1
    export UV_PYTHON_DOWNLOADS=never

%runscript
    exec /usr/local/bin/glnis_gammaboard_sampler "$@"

%test
    python - <<'PY'
import gammaboard_process
import glnis
from glnis import _rust
import madnis
import madnis_sampler
import run_sampler
assert _rust.health_check() == "glnis-gammaboard-api rust extension ok"
assert callable(run_sampler.main)
print("glnis gammaboard sampler runtime ok")
PY
